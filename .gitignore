# ==========================================
# Print2Web - .gitignore
# ==========================================

# ------------------------------------------
# Dependencias de Node.js
# ------------------------------------------
node_modules/
jspm_packages/

# ------------------------------------------
# Variables de entorno y secretos
# ------------------------------------------
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env*.local

# Mantener plantilla de variables de entorno versionada
!.env.example

# ------------------------------------------
# Vercel (artefactos de compilación y CLI)
# ------------------------------------------
.vercel

# ------------------------------------------
# Archivos de registro y logs
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Caché y temporales
# ------------------------------------------
.cache/
tmp/
temp/
.temp/

# ------------------------------------------
# Archivos del Sistema Operativo
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------
# Editores de código e IDEs
# ------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ------------------------------------------
# Archivos multimedia / específicos del proyecto
# ------------------------------------------
videoError_nogithub.mp4

# ------------------------------------------
# Herramientas de Auditoría y Reportes Temporales
# ------------------------------------------
.lighthouseci/
lighthouse-reports/
*.report.tmp.*
*.lhr.tmp.json

# ------------------------------------------
# Documentación, Auditorías y Análisis (docs/)
# ------------------------------------------

docs/
# Archivos temporales, borradores y caché dentro de docs/
docs/**/.cache/
docs/**/tmp/
docs/**/temp/
docs/**/*.tmp
docs/**/*.bak
docs/**/~*
docs/**/.*.swp

# Grabaciones de sesión y datos sensibles (privacidad / RGPD)
docs/**/recordings/
docs/**/sessions/
docs/**/raw-data/
docs/analisis-calor/recordings/
docs/analisis-calor/raw/
docs/analisis-calor/heatmaps/*.raw.json
docs/analisis-calor/heatmaps/*.csv

# Exportaciones pesadas de Lighthouse / Auditorías (HTML y JSON interactivos)
docs/**/lighthouse-reports/
docs/lighthouse/*.html
docs/lighthouse/*.json
docs/**/*.lhr.json
docs/**/*.lhr.html

# Excepciones garantizadas: Documentación, READMEs e informes finales (Markdown y PDF)
!docs/**/README.md
!docs/**/*.md
!docs/**/*.pdf

