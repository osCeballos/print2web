# Renombra este archivo a ".env" en tu entorno local (o configúralo en el dashboard de Vercel)
# y reemplaza los valores por tus credenciales reales.

# URL base pública del proyecto (CRÍTICO para evitar Host Header Poisoning)
# Producción ej: https://tramasweb.com | Desarrollo local ej: http://localhost:3000
APP_URL=https://tramasweb.com

# Clave secreta de Stripe (empieza por sk_test_... para pruebas o sk_live_... para producción)
STRIPE_SECRET_KEY=sk_test_TU_CLAVE_SECRETA_DE_STRIPE

# Secreto del Webhook de Stripe (lo consigues al registrar tu endpoint en el dashboard de Stripe)
STRIPE_WEBHOOK_SECRET=whsec_TU_SECRETO_DE_WEBHOOK

# Clave de API de Resend (para enviar correos)
RESEND_API_KEY=re_TU_CLAVE_API_DE_RESEND

# Email al que quieres que lleguen las notificaciones de los pedidos
ADMIN_EMAIL=tu.correo@ejemplo.com

# Token de Lectura/Escritura de Vercel Blob (para guardar los PDFs subidos de forma privada)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_TU_TOKEN

# Upstash Redis (para Rate Limiting e Idempotencia en Serverless Functions)
# Crear una base de datos gratuita en https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://tu-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_token_upstash_redis

# (Opcional) Sobrescritura de Precios de Imprenta en Servidor (Valores por defecto en EUR)
PRECIO_PAGINA_COLOR=0.50
PRECIO_PAGINA_BW=0.30
PRECIO_ENCUADERNACION=2.00
PRECIO_ENVIO=5.00
