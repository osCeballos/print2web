# Renombra este archivo a ".env" en tu entorno local (o configúralo en Vercel)
# y reemplaza los valores por tus credenciales reales.

# Clave secreta de Stripe (empieza por sk_test_... para pruebas o sk_live_... para producción)
STRIPE_SECRET_KEY=sk_test_TU_CLAVE_SECRETA_DE_STRIPE

# Secreto del Webhook de Stripe (lo consigues al registrar tu endpoint en el dashboard de Stripe)
STRIPE_WEBHOOK_SECRET=whsec_TU_SECRETO_DE_WEBHOOK

# Clave de API de Resend (para enviar correos)
RESEND_API_KEY=re_TU_CLAVE_API_DE_RESEND

# Email al que quieres que lleguen las notificaciones de los pedidos
ADMIN_EMAIL=tu.correo@ejemplo.com

# Token de Lectura/Escritura de Vercel Blob (para guardar los PDFs subidos)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_TU_TOKEN
